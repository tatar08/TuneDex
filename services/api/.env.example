# TuneDeck API — example environment. No real secrets here.
APP_ENV=dev                      # dev | staging | production
BUILD_VERSION=0.1.0-dev
PORT=3100
DATABASE_URL=postgres://tunedeck:CHANGE_ME@localhost:5432/tunedeck
# OIDC (Keycloak working default). Tokens are verified against this issuer/audience via JWKS.
OIDC_ISSUER=http://localhost:8080/realms/tunedeck
OIDC_AUDIENCE=tunedeck-api
OIDC_JWKS_URI=http://localhost:8080/realms/tunedeck/protocol/openid-connect/certs
OIDC_ALGORITHMS=RS256
