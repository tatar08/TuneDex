# TuneDeck API — example environment. No real secrets here.
APP_ENV=dev                      # dev | staging | production
BUILD_VERSION=0.1.0-dev
PORT=3100
DATABASE_URL=postgres://tunedeck:CHANGE_ME@localhost:5432/tunedeck
# OIDC (Keycloak working default). Tokens are verified against this issuer/audience via JWKS.
OIDC_ISSUER=http://localhost:8080/realms/tunedeck
OIDC_AUDIENCE=tunedeck-api
OIDC_JWKS_URI=http://localhost:8080/realms/tunedeck/protocol/openid-connect/certs
OIDC_ALGORITHMS=RS256
# Keycloak client whose service account deletes the Keycloak user when an account is deleted.
# Required in staging/production; optional in dev (deletion then keeps the Keycloak user). Set the secret outside this file.
# KEYCLOAK_ADMIN_CLIENT_ID=tunedeck-api-admin
# KEYCLOAK_ADMIN_CLIENT_SECRET=
# Ed25519 key that signs GET /v1/config (generate with `npm run config-key`). Required in staging/production;
# optional in dev (a throwaway key per start). Set it outside this file.
# CONFIG_SIGNING_KEY=
# Daily removal of audit records older than 180 days (off until the retention period is confirmed).
AUDIT_RETENTION_ENABLED=false
# Scheduled stream health checks of published stations (off by default). Interval 5-1440 minutes.
STATION_CHECK_ENABLED=false
STATION_CHECK_INTERVAL_MIN=15
STATION_CHECK_REGION=default
# Per-minute request limits (Doc 17). Reads/writes are per signed-in user; the public catalog is per client address.
RATE_LIMIT_READS_PER_MIN=120
RATE_LIMIT_WRITES_PER_MIN=30
RATE_LIMIT_CATALOG_PER_MIN=60
# Number of proxies in front of the API that set X-Forwarded-For (0 = use the socket address).
TRUST_PROXY_HOPS=0
