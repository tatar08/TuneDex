{
  "name": "@tunedeck/api",
  "version": "0.1.0",
  "private": true,
  "description": "TuneDeck backend API (NestJS): settings, devices, staff roles and the radio station catalog.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp -r src/db/migrations dist/db/",
    "start": "node dist/main.js",
    "migrate": "node dist/db/migrate.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "staff": "node dist/staff/staff-cli.js",
    "config-key": "node dist/app-config/config-key-cli.js",
    "restore-reconcile": "node dist/account/restore-reconcile-cli.js",
    "checker": "node dist/checker.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "express": "5.2.1",
    "jose": "5.10.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "jest": "29.7.0",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "typescript": "5.9.3"
  }
}
