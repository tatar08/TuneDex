# TuneDeck console (Next.js BFF). Example only — no real secrets.
CONSOLE_BASE_URL=http://localhost:3200      # public origin; must match the redirect URI registered in Keycloak
API_BASE_URL=http://localhost:3100          # services/api, reached server-side only
OIDC_ISSUER=http://localhost:8080/realms/tunedeck
OIDC_CLIENT_ID=tunedeck-console             # confidential client
OIDC_CLIENT_SECRET=CHANGE_ME
OIDC_SCOPES=openid profile                  # the API audience must be mapped onto the access token in Keycloak
OIDC_ALGORITHMS=RS256
# OIDC_MFA_ACR=                             # acr_values asked for when staff confirm MFA; match the API's STAFF_MFA_ACR
SESSION_SECRET=CHANGE_ME_TO_32+_RANDOM_CHARS # signs the short-lived login transaction cookie
# APP_ENV=dev                               # environment and build written on every log line (default unknown)
# BUILD_VERSION=local
SESSION_DATABASE_URL=postgres://tunedeck_console:CHANGE_ME@localhost:5432/tunedeck  # shared sessions; required outside localhost, creates table console_sessions
