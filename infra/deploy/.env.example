# Copy to .env on the server and replace every value. .env is gitignored; never commit it.
# Random secrets: openssl rand -hex 24
APP_ENV=staging
# Names api.<DOMAIN>, auth.<DOMAIN>, console.<DOMAIN> must resolve to this server.
DOMAIN=staging.example.com
ACME_EMAIL=ops@example.com
BUILD_VERSION=main
POSTGRES_PASSWORD=CHANGE_ME
KEYCLOAK_DB_PASSWORD=CHANGE_ME
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
CONSOLE_CLIENT_SECRET=CHANGE_ME
API_ADMIN_CLIENT_SECRET=CHANGE_ME
SESSION_SECRET=CHANGE_ME_TO_32+_RANDOM_CHARS
# Ed25519 private key for signed remote config, PEM on one line with \n (see services/api README). The apps
# pin its public key; staging and production use different keys.
CONFIG_SIGNING_KEY=CHANGE_ME
# Optional
ALERT_WEBHOOK_URL=
RADIO_BROWSER_BASE_URL=
CORS_ALLOWED_ORIGINS=
STATION_CHECK_ENABLED=false
