# Copy to .env and replace every value (openssl rand -hex 24 is fine). .env is gitignored.
POSTGRES_PASSWORD=CHANGE_ME
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
CONSOLE_CLIENT_SECRET=CHANGE_ME
API_ADMIN_CLIENT_SECRET=CHANGE_ME
SESSION_SECRET=CHANGE_ME_TO_32+_RANDOM_CHARS
# Host port for Postgres; change (e.g. 55432) if this machine already uses 5432.
POSTGRES_HOST_PORT=5432
# Host ports for the API and console; change (e.g. 3101 / 3201) if they are taken. The console URL follows CONSOLE_HOST_PORT.
API_HOST_PORT=3100
CONSOLE_HOST_PORT=3200
